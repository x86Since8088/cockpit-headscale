[Unit]
Description=Reconcile headscale subnet-router host state against the stored policy
Documentation=file:/etc/headscale/routing-policy.json
# tailscaled must be up first: hs-policy reads its prefs and inspects the ts-*
# chains it installs, and would otherwise report every route as missing on boot.
After=network-online.target snap.tailscale.tailscaled.service
Wants=network-online.target

[Service]
Type=simple
# The loop lives here rather than in a timer so the interval is visible and the
# unit's own logs carry the reconcile history. Reconciling costs a few reads;
# the thing it guards against (a container-engine restart stripping the jump
# into ts-forward) leaves the node online and serving nothing, so checking often
# is far cheaper than missing it.
ExecStart=/bin/sh -c 'while :; do /usr/local/sbin/hs-policy apply; sleep 30; done'
Restart=always
RestartSec=10

AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run /proc/sys/net
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
